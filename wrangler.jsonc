{
  // Static export served by Workers Static Assets. `npm run build` writes ./out,
  // and Workers Builds runs `npx wrangler deploy`, which reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-place-agent-jhedai",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./out",
    // Next's export writes /agentes.html; serve it at /agentes.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html instead of a bare 404.
    "not_found_handling": "404-page"
  }
}
