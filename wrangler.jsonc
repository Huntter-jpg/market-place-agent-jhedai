{
  // Static export served by Workers Static Assets. `npm run build` writes ./out,
  // and Workers Builds runs `npx wrangler deploy`, which reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-place-agent-jhedai",
  "compatibility_date": "2026-05-01",
  /* Serve the production hostname from this Worker. A route, not a custom
     domain: the DNS record for agentes.jhedai.com stays exactly as it is, so
     there is no window in which the name fails to resolve. zone_id rather
     than zone_name, which the docs note needs account scope on the token. */
  "routes": [
    {
      "pattern": "agentes.jhedai.com/*",
      "zone_id": "0f96b8398c1b0fb5ff2b7f196273f10a"
    }
  ],
  /* Adding `routes` makes wrangler infer workers_dev as false. Stated here so
     the intent is recorded and a dashboard toggle cannot flip it back on the
     next deploy: production is reached at agentes.jhedai.com only, with no
     duplicate workers.dev hostname serving the same pages. */
  "workers_dev": false,
  /* Preview URLs default to the workers_dev setting, so they need their own
     opt-in. Kept on: a branch push builds a preview to check against
     `npm run check:prod` before anything reaches production. */
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    // Next's export writes /agentes.html; serve it at /agentes.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html instead of a bare 404.
    "not_found_handling": "404-page"
  }
}
